{
  "manifest_version": 3,
  "name": "妙记导出",
  "version": "0.2.0",
  "description": "导出妙记的会议纪要与文字记录，支持发言人和时间筛选、连续发言合并及企业专属域名。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://*.feishu.cn/*", "https://*.feishuapp.cn/*",
    "https://*.larksuite.com/*", "https://*.larkoffice.com/*",
    "https://*.xfchat.iflytek.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "妙记导出", "default_popup": "popup.html"},
  "options_page": "popup.html",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": [
      "https://*.feishu.cn/*", "https://*.feishuapp.cn/*",
      "https://*.larksuite.com/*", "https://*.larkoffice.com/*",
      "https://*.xfchat.iflytek.com/*"
    ],
    "js": ["shared.js", "exporter.js", "extractor.js", "content.js"],
    "run_at": "document_idle"
  }]
}
